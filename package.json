{
  "name": "ai-mystery-room",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "start": "npm run start --workspace apps/api",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/api"
  },
  "engines": { "node": ">=20 <27" },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.7.3" }
}
